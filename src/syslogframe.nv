// syslogframe.nv — the load-bearing interface: where one message ends,
// decided by a reader that performs nothing.
//
// WHY FRAMING IS A SEPARATE PROBLEM
//
// Over UDP a syslog message needs no framing: one datagram is one
// message and the network says where it ends.  Over TCP and over TLS
// there is no such boundary, and RFC 6587 writes down the two ways
// implementations find one.
//
// OCTET COUNTING (§ 3.4.1) puts the length in front: a decimal number
// beginning with a non-zero digit, one space, then exactly that many
// octets of message.  It can carry any octets at all, including
// newlines, and it is what RFC 5425's TLS transport requires.
//
// NON-TRANSPARENT FRAMING (§ 3.4.2) puts a delimiter after: usually a
// line feed, sometimes a carriage return and line feed, sometimes a
// NUL.  It is what almost everything sends, because it is what writing
// a log line to a socket already looks like, and it cannot carry a
// message containing the delimiter — there is no escape for it in the
// section.  A sender that writes one anyway splits its own message
// into two, and the receiver sees two malformed messages rather than
// one good one.  `format` in this module refuses to do that.
//
// THE FEED-AND-DRAIN SHAPE
//
// This is a `core` package, so nothing here may open a socket, set a
// timeout or wait.  A syslog stream is exactly what a caller wants to
// read incrementally.  Those two facts are reconciled by a state
// machine the host pumps: it holds the connection, hands over whatever
// octets it has, and takes back the frames those octets completed.
//
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     let fed = syslogframe.feed(r, chunk)!       // as many times as you like
//     let more = syslogframe.take(fed.reader)!    // until `frame` is None
//
// ONE FRAME PER CALL, and `frame: None` means "not yet" and not
// "never".  A partial message is the ordinary case on a socket, and a
// reader that reported it as an error would have every caller filtering
// one variant out of its logs forever.
//
// A FRAME IS OCTETS, NOT A PARSED MESSAGE
//
// `take` hands back the octets of one message and does not parse them.
// That is deliberate and it is what makes a relay possible: RFC 6587
// § 3.4 is about the transport and says nothing about what is inside a
// frame, and a relay forwarding a message must forward THE OCTETS IT
// RECEIVED.  A reader that parsed and re-rendered would change the
// spelling of a timestamp, the order of the structured data, the
// spacing — and would corrupt anything it could not parse, which is
// the traffic most worth forwarding.  A collector calls
// `syslogmsg.detect_format` and then the parser it names; a relay does
// not have to call anything.
//
// THE FRAMINGS CANNOT BE MIXED, AND THE READER IS TOLD WHICH ONE
//
// A reader holds one framing for the whole stream.  Deciding per
// message cannot be done safely: the octets of an RFC 3164 message can
// begin with a digit, so a stream of them read as octet-counted
// produces frames cut at lengths taken out of somebody's log text.
// `SyslogFramingDetect` exists for a receiver that genuinely does not
// know which of its senders it has, and it decides ONCE, from the first
// octet, and then holds that answer for the connection — the rule is
// in `detect_framing`.

use syslogerror

// ── reading the octets ───────────────────────────────────────────────
//
// Every scanner here is byte-at-a-time and bounds-checked: the octets
// arrived from a network, so past the end is a value (-1) and not a
// panic.  Same shape as the scanners in the parsers beside this module,
// and for the same reason.

// Whether a byte is an ASCII digit.
fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

// The byte at an offset, or -1 past the end.
fn byte_at(octets: [u8], i: Int) -> Int
    if i < 0 or i >= list.len(octets)
        return -1
    octets[i] as Int

// The frame size `default_limits` allows: four times the 2048 octets
// RFC 5424 § 6.1 asks a receiver to be able to support, which leaves
// room for the senders that ignore the recommendation.
fn default_max_frame_octets() -> Int
    8192

// The frame size `small_limits` allows: RFC 5424 § 6.1's minimum, and
// nothing more.
fn small_max_frame_octets() -> Int
    480

// A count in decimal, as octets — the MSG-LEN of RFC 6587 § 3.4.1.
fn digits_of(n: Int) -> [u8]
    let text = str.from_int(n)
    bytes.to_byte_list(bytes.from_str(text))

// Which framing an octet begins, or `None` when it begins neither.
//
// RFC 6587 § 3.4.1's MSG-LEN begins with a non-zero decimal digit and a
// syslog message begins with `<` (RFC 5424 § 6.2.1, RFC 3164 § 4.1.1),
// so the two framings cannot begin the same way and one octet is enough
// to tell them apart.
//
// It says nothing about which trailer a non-transparent stream uses.
// RFC 6587 § 3.4.2 calls the line feed the usual one, so that is what a
// detecting reader settles on; a receiver whose senders write something
// else has to be told.
fn framing_for_octet(first: Int) -> ?SyslogFraming
    if first == '<'
        return Some(SyslogNonTransparent(SyslogTrailerLf))
    if first >= '1' and first <= '9'
        return Some(SyslogOctetCounting)
    None

// The octet a detecting reader decides from: the first octet of the
// stream, which is already in the buffer if any octet has arrived.
fn first_octet_of(r: SyslogReader, arriving: [u8]) -> Int
    if list.len(r.pending) > 0
        return byte_at(r.pending, 0)
    byte_at(arriving, 0)

// The same reader, holding a framing it has settled on.
fn settled_as(r: SyslogReader, framing: SyslogFraming) -> SyslogReader
    SyslogReader { framing: framing, limits: r.limits, pending: r.pending, consumed: r.consumed }

// The reader that answers a detection, once, from the first octet.
//
// A reader made with `SyslogFramingDetect` and given an octet that
// begins neither framing stays undecided rather than guessing: the first
// octet of a stream cannot change, so a guess made from it could never
// be corrected and the connection would be cut at lengths invented from
// somebody's log text.  It keeps buffering instead, and the limit is
// what stops it — the same unbounded-holding failure as a sender that
// never writes a trailer.
fn settle(r: SyslogReader, arriving: [u8]) -> SyslogReader
    match r.framing
        SyslogFramingDetect =>
            let head = first_octet_of(r, arriving)
            match framing_for_octet(head)
                Some(f) => settled_as(r, f)
                None    => r
        _                   => r

// The reader carried forward past the octets that came out of it.
fn reader_after(r: SyslogReader, remaining: [u8], consumed: Int) -> SyslogReader
    SyslogReader { framing: r.framing, limits: r.limits, pending: remaining, consumed: consumed }

// A reader and the fact that nothing came out of it.
fn no_frame(r: SyslogReader) -> SyslogFed
    SyslogFed { reader: r, frame: None }

// A reader and the one frame that came out of it.
//
// One place builds a `SyslogFrame`, so `at` and the octets are written
// in one order everywhere and there is one site to read when a frame
// is reported at the wrong offset.
fn with_frame(r: SyslogReader, octets: [u8], at: Int) -> SyslogFed
    let one = SyslogFrame { octets: octets, at: at }
    let maybe = Some(one)
    SyslogFed { reader: r, frame: maybe }

// The offset of the first octet equal to `b` at or after `from`, or -1.
fn find_byte_from(octets: [u8], b: Int, from: Int) -> Int
    let n = list.len(octets)
    var i = from
    while i < n
        if byte_at(octets, i) == b
            return i
        i += 1
    -1

// The offset of the first `%d13 %d10` at or after `from`, or -1.
//
// A carriage return with no line feed after it yet is a prefix and not a
// trailer: the line feed it is waiting for may be the next octet to
// arrive, which on a socket is the ordinary case and not a fault.
fn find_crlf_from(octets: [u8], from: Int) -> Int
    let n = list.len(octets)
    var i = from
    while i + 1 < n
        if byte_at(octets, i) == 13 and byte_at(octets, i + 1) == 10
            return i
        i += 1
    -1

// Where a message framed this way ends, or -1 when no trailer has
// arrived yet.
fn trailer_at(octets: [u8], from: Int, trailer: SyslogTrailer) -> Int
    match trailer
        SyslogTrailerLf   => find_byte_from(octets, 10, from)
        SyslogTrailerNul  => find_byte_from(octets, 0, from)
        SyslogTrailerCrLf => find_crlf_from(octets, from)

// What the octets at the head of an octet-counted stream say about the
// frame that follows.
struct LengthPrefix
    // Whether the whole prefix is there: the digits AND the space after
    // them.  A prefix that is still arriving is not a fault.
    complete: Bool
    // The number it names.  Meaningless while `complete` is false, and a
    // LOWER BOUND once the number has passed ten to the seventeenth — a
    // length that long is over any limit a reader can be given, and
    // carrying it exactly would overflow before it could be refused.
    declared: Int
    // The octets the prefix occupies: the digits and the space, so the
    // message starts at this offset.  Zero while `complete` is false.
    width: Int

// The MSG-LEN at the head of the buffer, parsed as far as it goes.
//
// RFC 6587 § 3.4.1 writes it as a non-zero digit, more digits, and one
// space.  Anything else is `SyslogBadFrameLength`, and it is a FRAMING
// fault because there is nothing in an octet-counted stream to
// resynchronise on: the length that would have said where the next
// message starts is the thing that is unreadable.
fn length_prefix(octets: [u8]) -> Result<LengthPrefix, SyslogError>
    var i = 0
    var value = 0
    var digits = 0
    while is_digit(byte_at(octets, i))
        if value < 100000000000000000
            value = value * 10 + (byte_at(octets, i) - '0')
        i += 1
        digits += 1
    if digits == 0
        if byte_at(octets, i) < 0
            return Ok(LengthPrefix { complete: false, declared: 0, width: 0 })
        return Err(SyslogBadFrameLength(i))
    if byte_at(octets, 0) == '0'
        return Err(SyslogBadFrameLength(0))
    if byte_at(octets, i) == ' '
        return Ok(LengthPrefix { complete: true, declared: value, width: i + 1 })
    if byte_at(octets, i) < 0
        return Ok(LengthPrefix { complete: false, declared: value, width: 0 })
    Err(SyslogBadFrameLength(i))

// The same fault, positioned in the stream rather than in the buffer.
//
// `length_prefix` reads the octets the reader is holding and counts
// from the first of them; a fault a person reads is counted from the
// first octet the reader was EVER given, because a chunk boundary is an
// artefact of how the host read its socket and must not appear in it.
fn at_stream_offset(e: SyslogError, by: Int) -> SyslogError
    match e
        SyslogBadFrameLength(at) => SyslogBadFrameLength(at + by)
        // cov: skip — `length_prefix` answers `SyslogBadFrameLength` and
        // no other fault, so this arm only keeps the match exhaustive.
        _                        => e

// One frame out of an octet-counted buffer, or none.
fn take_counted(r: SyslogReader) -> Result<SyslogFed, SyslogError>
    let prefix = length_prefix(r.pending)
    match prefix
        Err(e) =>
            return Err(at_stream_offset(e, r.consumed))
        Ok(p)  =>
            let held = list.len(r.pending)
            let limit = r.limits.max_frame_octets
            if not p.complete
                // A length still being written holds only its own
                // digits, so a buffer this size is a sender that is not
                // a sender of this framing at all.
                if held > limit
                    return Err(SyslogFrameTooLarge(held, limit))
                return Ok(no_frame(r))
            // The declared length is the whole cost of the frame, and
            // it is known before one octet of the message arrives: a
            // ten-digit length is ten octets to send.
            if p.declared > limit
                return Err(SyslogFrameTooLarge(p.declared, limit))
            let total = p.width + p.declared
            if held < total
                return Ok(no_frame(r))
            let message = list.slice(r.pending, p.width, total)
            let remaining = list.slice(r.pending, total, held)
            let advanced = reader_after(r, remaining, r.consumed + total)
            Ok(with_frame(advanced, message, r.consumed + p.width))

// One frame out of a non-transparently framed buffer, or none.
fn take_delimited(r: SyslogReader, trailer: SyslogTrailer) -> Result<SyslogFed, SyslogError>
    let at = trailer_at(r.pending, 0, trailer)
    let held = list.len(r.pending)
    if at < 0
        // The limit is what bounds this framing: § 3.4.2 has no length
        // to check, so a sender that never writes the trailer would
        // otherwise make the reader hold the connection forever.
        if held > r.limits.max_frame_octets
            return Err(SyslogFrameTooLarge(held, r.limits.max_frame_octets))
        return Ok(no_frame(r))
    let width = list.len(trailer_octets(trailer))
    let message = list.slice(r.pending, 0, at)
    let remaining = list.slice(r.pending, at + width, held)
    let advanced = reader_after(r, remaining, r.consumed + at + width)
    Ok(with_frame(advanced, message, r.consumed))

// Every frame the buffer already holds.
//
// The pump `feed` and `take` write once, here, rather than at each call
// site: `frame: None` is the signal to stop, and it is not a fault.
fn take_all(r: SyslogReader) -> Result<SyslogDrained, SyslogError>
    var frames: [SyslogFrame] = []
    var current = r
    var more = true
    while more
        match take(current)
            Err(e)  =>
                return Err(e)
            Ok(fed) =>
                current = fed.reader
                match fed.frame
                    Some(f) => list.push(frames, f)
                    None    =>
                        more = false
    Ok(SyslogDrained { reader: current, frames: frames })

// What the octets still in the buffer are worth when the peer closes.
//
// A close with nothing pending is an ordinary end under both framings.
// For the rest they disagree, and both answers matter: under
// non-transparent framing those octets ARE a message, because § 3.4.2
// does not require a trailer on the last one, and the last line of a
// connection is the one that says why the sender is going away; under
// octet counting the same octets are a prefix, because the length said
// how much was coming and it did not come.
fn close_last(r: SyslogReader) -> Result<SyslogFed, SyslogError>
    let held = list.len(r.pending)
    if held == 0
        return Ok(no_frame(r))
    match r.framing
        SyslogOctetCounting     =>
            return Err(SyslogFrameTruncated(r.consumed + held))
        SyslogNonTransparent(_) =>
            let message = r.pending
            // Bound before the reader is built: an inline `as [u8]` cast
            // written as a struct-literal field is stored empty by the
            // compiled leg; see
            // codegen-llvm/an-identity-cast-in-a-struct-literal-field-or-tuple-element-reads-as-empty.
            let no_octets = [] as [u8]
            let advanced = reader_after(r, no_octets, r.consumed + held)
            return Ok(with_frame(advanced, message, r.consumed))
        SyslogFramingDetect     =>
            // Nothing settled the framing, so nothing can say where the
            // buffered octets end.  Calling them a message would be
            // inventing a boundary the stream never stated, and the
            // octets begin with neither `<` nor a digit, so they are not
            // a stream either framing can read.
            return Err(SyslogBadFrameLength(0))

// The octet that ends a message under non-transparent framing.
//
// RFC 6587 § 3.4.2 names these three and says implementations vary,
// which is why the reader is told which one rather than guessing.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     println("${list.len(syslogframe.trailer_octets(SyslogTrailerCrLf))}")   // 2
// ```
pub enum SyslogTrailer
    // A line feed, `%d10`.  The common one.
    SyslogTrailerLf
    // A carriage return and a line feed, `%d13 %d10`.
    SyslogTrailerCrLf
    // A NUL, `%d00`.
    SyslogTrailerNul

// How a stream is cut into messages.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     println("${syslogframe.pending_len(r)}")    // 0
// ```
pub enum SyslogFraming
    // RFC 6587 § 3.4.1: a decimal length, a space, then that many
    // octets.  Carries any octets, and required by RFC 5425's TLS
    // transport.
    SyslogOctetCounting
    // RFC 6587 § 3.4.2: a message, then the trailer.  Cannot carry a
    // message containing the trailer octet.
    SyslogNonTransparent(trailer: SyslogTrailer)
    // Decide from the first octet of the stream, once, and hold that
    // answer for the connection.  `detect_framing` is the rule.  A
    // reader made with this answers the framing it settled on from
    // `framing_of`, so a caller can log which of its senders speaks
    // which.
    SyslogFramingDetect

// What a reader will refuse to grow past.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     println("${syslogframe.default_limits().max_frame_octets}")
// ```
pub struct SyslogLimits
    // The most octets one message may have.  Exceeding it is
    // `SyslogFrameTooLarge`, and it is a FRAMING fault, so the
    // transport is finished.
    //
    // The limit exists because the unbounded version is a denial of
    // service that costs the sender nothing: under octet counting a
    // ten-digit length is ten octets to send and would be a gigabyte
    // to hold, and under non-transparent framing a sender that never
    // writes the trailer makes the reader buffer the connection
    // forever.  It is a value the caller owns rather than a constant
    // this package chose, because a collector and a microcontroller
    // want numbers three orders of magnitude apart.
    max_frame_octets: Int

// One message's octets, and where in the stream they started.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
//                                syslogframe.default_limits())
//     match syslogframe.feed(r, [10 as u8])
//         Ok(fed) =>
//             match fed.frame
//                 Some(f) => println("${f.at} + ${list.len(f.octets)}")
//                 None    => println("nothing complete yet")
//         Err(e)  => println(e.message())
// ```
pub struct SyslogFrame
    // The message, with the length prefix or the trailer removed.
    // Exactly what the sender sent, so a relay can forward it
    // unchanged.
    octets: [u8]
    // The offset of this message's first octet, counted from the first
    // octet the reader was ever given.  The same counter `offset`
    // answers and the same one a `SyslogError` carries.
    at: Int

// A reader and the one frame that came out of it, if one did.
//
// A struct rather than a tuple because the two halves are used at
// different places: the caller reassigns the reader and dispatches on
// the frame.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     match syslogframe.take(r)
//         Ok(fed) => println("${syslogframe.pending_len(fed.reader)}")   // 0
//         Err(e)  => println(e.message())
// ```
pub struct SyslogFed
    // The reader, carried forward.
    reader: SyslogReader
    // `None` means no complete message in what the reader has been
    // given yet, which on a socket is the ordinary case and not a
    // fault.
    frame: ?SyslogFrame

// A reader and every frame a drain produced.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
//                                syslogframe.default_limits())
//     match syslogframe.drain(r, [65 as u8, 10 as u8])
//         Ok(d)  => println("${list.len(d.frames)}")     // 1
//         Err(e) => println(e.message())
// ```
pub struct SyslogDrained
    // The reader, carried forward.
    reader: SyslogReader
    // Every frame that came out, in order.  Empty when the octets
    // completed none.
    frames: [SyslogFrame]

// The state between "some octets turned up" and "here is a message".
//
// Opaque: the fields are here because a struct needs them, and a
// caller that reaches into one has coupled itself to a buffering
// decision this package intends to change.  `pending_len`, `offset`
// and `framing_of` are the three facts about a reader that are
// anybody's business.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     println("${syslogframe.offset(r)}")      // 0
// ```
pub struct SyslogReader
    framing: SyslogFraming
    limits: SyslogLimits
    pending: [u8]
    consumed: Int

// A frame of at most 8192 octets.
//
// Four times what RFC 5424 § 6.1 says a receiver should support, which
// leaves room for the senders that ignore it, and small enough that a
// thousand idle connections are eight megabytes rather than a machine.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     println("${syslogframe.default_limits().max_frame_octets}")   // 8192
// ```
pub fn default_limits() -> SyslogLimits
    SyslogLimits { max_frame_octets: default_max_frame_octets() }

// A frame of at most 480 octets.
//
// The minimum RFC 5424 § 6.1 requires a receiver to support, and
// nothing more.  Named here rather than left to each caller with a
// small memory budget to invent, because every one of them that
// invented it separately would pick a different number and none of
// them would be the one the RFC names.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     println("${syslogframe.small_limits().max_frame_octets}")     // 480
// ```
pub fn small_limits() -> SyslogLimits
    SyslogLimits { max_frame_octets: small_max_frame_octets() }

// A reader holding nothing, for one framing and one set of limits.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
//                                syslogframe.default_limits())
//     println("${syslogframe.pending_len(r)}")    // 0
// ```
pub fn reader(framing: SyslogFraming, limits: SyslogLimits) -> SyslogReader
    // Bound before the literal: an inline `as [u8]` cast written as a
    // struct-literal field is stored empty by the compiled leg, so every
    // reader ever made would hold somebody else's octets; see
    // codegen-llvm/an-identity-cast-in-a-struct-literal-field-or-tuple-element-reads-as-empty.
    let no_octets = [] as [u8]
    SyslogReader { framing: framing, limits: limits, pending: no_octets, consumed: 0 }

// Adds octets and takes one frame, if the addition completed one.
//
// Takes ONE.  Octets that complete three messages — a busy sender
// whose three lines arrived in one packet — leave two inside, and
// `take` is what gets them.  `drain` is that loop written once.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     // "5 " with no message yet: a length, and nothing to count.
//     match syslogframe.feed(r, [53 as u8, 32 as u8])
//         Ok(fed) =>
//             match fed.frame
//                 None    => println("partial, as expected")
//                 Some(_) => println("a message")
//         Err(e)  => println(e.message())
// ```
pub fn feed(r: SyslogReader, octets: [u8]) -> Result<SyslogFed, SyslogError>
    // The framing settles from the first octet of the stream, which is
    // in the buffer only if the caller fed nothing before this.
    let settled = settle(r, octets)
    let held = settled.pending
    let grown_octets = list.concat(held, octets)
    let grown = reader_after(settled, grown_octets, settled.consumed)
    take(grown)

// Takes one frame if a complete one is already buffered, adding
// nothing.
//
// `frame` is `None` when the buffer holds a prefix, and the reader
// comes back unchanged.  A caller loops on this until `None` and then
// goes back to its socket.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     match syslogframe.take(r)
//         Ok(fed) =>
//             match fed.frame
//                 None    => println("an empty reader has nothing to give")
//                 Some(_) => println("this cannot happen here")
//         Err(e)  => println(e.message())
// ```
pub fn take(r: SyslogReader) -> Result<SyslogFed, SyslogError>
    match r.framing
        SyslogOctetCounting     =>
            return take_counted(r)
        SyslogNonTransparent(t) =>
            return take_delimited(r, t)
        SyslogFramingDetect     =>
            // No octet that settles the framing has arrived, so there is
            // no way to cut anything out.  "Not yet" is `frame: None`
            // here as everywhere else: what is in the buffer is a
            // prefix of a stream, not a fault.
            return Ok(no_frame(r))

// Adds octets and takes every frame they completed.
//
// `feed` and `take` with the pump written once, here, instead of once
// per caller.  Use `feed` when the caller wants to act on each message
// before reading the next, and this when it wants the batch.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
//                                syslogframe.default_limits())
//     // Two lines in one packet, which is the ordinary case.
//     match syslogframe.drain(r, [65 as u8, 10 as u8, 66 as u8, 10 as u8])
//         Ok(d)  => println("${list.len(d.frames)}")    // 2
//         Err(e) => println(e.message())
// ```
pub fn drain(r: SyslogReader, octets: [u8]) -> Result<SyslogDrained, SyslogError>
    match feed(r, octets)
        Err(e)  =>
            return Err(e)
        Ok(fed) =>
            match take_all(fed.reader)
                Err(e)   =>
                    return Err(e)
                Ok(rest) =>
                    match fed.frame
                        Some(f) =>
                            // The frame `feed` took came before every
                            // frame `take_all` took, and the two lists
                            // are one answer in that order.
                            let first = [f]
                            let rest_frames = rest.frames
                            let all = list.concat(first, rest_frames)
                            let out_reader = rest.reader
                            return Ok(SyslogDrained { reader: out_reader, frames: all })
                        None    =>
                            return Ok(rest)

// Tells the reader the peer closed, and takes the last frame.
//
// This is not a formality, and the two framings answer differently.
//
// Under non-transparent framing the octets before the close ARE a
// message: RFC 6587 § 3.4.2 does not require a trailer on the last
// one, and a receiver that dropped them would lose the final line of
// every connection — which is the line that says why the sender is
// going away.
//
// Under octet counting a partial frame is `SyslogFrameTruncated`.  The
// length said how much was coming and it did not come, so what arrived
// is a prefix of a message and not a short message.
//
// A close with nothing pending gives `frame: None` and no error, under
// both framings, which is an ordinary end of connection.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
//                                syslogframe.default_limits())
//     match syslogframe.finish(r)
//         Ok(fed) =>
//             match fed.frame
//                 None    => println("closed between messages")
//                 Some(_) => println("a last message with no trailer")
//         Err(e)  => println(e.message())
// ```
pub fn finish(r: SyslogReader) -> Result<SyslogFed, SyslogError>
    match take(r)
        Err(e)  =>
            return Err(e)
        Ok(fed) =>
            match fed.frame
                // A frame that was already complete when the peer closed
                // is the last frame, and the close adds nothing to it.
                Some(_) =>
                    return Ok(fed)
                None    =>
                    return close_last(fed.reader)

// How many octets the reader is holding.
//
// For a caller that bounds its own buffering, and for a supervisor
// that wants to notice a sender sitting on half a message forever.
// The limit bounds this too, but a caller may want to act before it
// does.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     println("${syslogframe.pending_len(r)}")     // 0
// ```
pub fn pending_len(r: SyslogReader) -> Int
    list.len(r.pending)

// How many octets this reader has consumed since it was made.
//
// The same counter every `SyslogFrame.at` and every positional
// `SyslogError` is measured in, so a caller can report a fault's
// position on a connection without keeping a count of its own.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())
//     println("${syslogframe.offset(r)}")          // 0
// ```
pub fn offset(r: SyslogReader) -> Int
    r.consumed

// The framing this reader is using.
//
// For a reader made with `SyslogFramingDetect` this answers
// `SyslogFramingDetect` until the first octet has arrived and the
// settled framing afterwards, so a collector can log which dialect
// each sender speaks and find the one that is about to be a problem.
// For any other reader it answers what it was made with.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     let r = syslogframe.reader(SyslogFramingDetect, syslogframe.default_limits())
//     match syslogframe.framing_of(r)
//         SyslogFramingDetect => println("nothing has arrived yet")
//         _                   => println("settled")
// ```
pub fn framing_of(r: SyslogReader) -> SyslogFraming
    r.framing

// Which framing some octets are in, or `None`.
//
// The rule is that the two framings cannot begin the same way.  An
// octet-counted frame begins with a non-zero decimal digit (RFC 6587
// § 3.4.1); a syslog message begins with `<` (RFC 5424 § 6.2.1, RFC
// 3164 § 4.1.1), and a non-transparent frame begins with the message.
// So `<` means non-transparent framing, `1` to `9` means octet
// counting, and anything else is neither.
//
// It says nothing about which trailer a non-transparent stream uses.
// A reader made with `SyslogFramingDetect` settles on
// `SyslogTrailerLf`, which is what RFC 6587 § 3.4.2 calls the usual
// one; a receiver whose senders write something else has to be told.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     match syslogframe.detect_framing([60 as u8])       // <
//         Some(SyslogOctetCounting) => println("counted")
//         Some(_)                   => println("a message, so non-transparent")
//         None                      => println("neither")
// ```
pub fn detect_framing(octets: [u8]) -> ?SyslogFraming
    framing_for_octet(byte_at(octets, 0))

// The octets a trailer is: one for a line feed or a NUL, two for a
// carriage return and line feed.
//
// ```novo
// use syslogframe
//
// fn main() [io]
//     println("${list.len(syslogframe.trailer_octets(SyslogTrailerLf))}")      // 1
//     println("${list.len(syslogframe.trailer_octets(SyslogTrailerCrLf))}")    // 2
// ```
pub fn trailer_octets(t: SyslogTrailer) -> [u8]
    match t
        SyslogTrailerLf   => [10 as u8]
        SyslogTrailerCrLf => [13 as u8, 10 as u8]
        SyslogTrailerNul  => [0 as u8]

// One message's octets, framed for sending.
//
// Under octet counting it writes the length in decimal, a space, and
// the message.  Under non-transparent framing it writes the message
// and the trailer — and REFUSES with `SyslogTrailerInMessage` if the
// message contains the trailer octet, naming where.
//
// That refusal is the point.  RFC 6587 § 3.4.2 gives no escape for a
// trailer inside a message, so writing one anyway produces two
// malformed messages at the receiver, and the caller who did it finds
// out from somebody else's log a week later.  The fix is octet
// counting, which carries any octets; the message does not have to
// change.
//
// `SyslogFramingDetect` is not a framing to write with, and is
// refused: detection is a question about a stream that is arriving.
//
// ```novo
// use syslogframe
// use syslogerror
//
// fn main() [io]
//     // A message with a newline in it, under line-feed framing.
//     match syslogframe.frame([65 as u8, 10 as u8, 66 as u8],
//                             SyslogNonTransparent(SyslogTrailerLf))
//         Ok(_)  => println("this does not happen")
//         Err(e) => println(syslogerror.code(e))     // trailer_in_message
// ```
pub fn frame(message: [u8], framing: SyslogFraming) -> Result<[u8], SyslogError>
    match framing
        SyslogOctetCounting           =>
            let n = list.len(message)
            // § 3.4.1's MSG-LEN begins with a non-zero digit, so a
            // zero-octet message has no spelling in this framing: `0 `
            // is a frame every reader of this package refuses, and
            // writing one would be the same failure as writing a
            // trailer inside a message.
            if n == 0
                return Err(SyslogBadFrameLength(0))
            let digits = digits_of(n)
            let with_space = list.concat(digits, [32 as u8])
            let out = list.concat(with_space, message)
            return Ok(out)
        SyslogNonTransparent(trailer) =>
            let at = trailer_at(message, 0, trailer)
            if at >= 0
                return Err(SyslogTrailerInMessage(at))
            let trailer_bits = trailer_octets(trailer)
            let out = list.concat(message, trailer_bits)
            return Ok(out)
        // Detection is a question about a stream that is arriving, and
        // `SyslogBadFrameLength` is the fault that says the framing the
        // caller named cannot frame anything at all.  There is no
        // variant for "not a framing to write with" — see the
        // CHANGELOG's `### Known`.
        SyslogFramingDetect           => Err(SyslogBadFrameLength(0))
