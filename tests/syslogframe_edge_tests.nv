// syslogframe_edge_tests.nv — the boundaries the API suite leaves open.
//
// Added while landing the package.  It is not part of the interface
// release, and three things in it are deliberate:
//
// 1. The first case is the API suite's `7 <13>abc` case spelled with
//    the octets that case names.  The release suite's own fixture is
//    one octet short of both its name and its two assertions (it feeds
//    `7 <13>ab`, eight octets, which cannot contain a seven-octet
//    message, so no implementation can satisfy it); the behavior the
//    case describes is pinned here instead, and the release suite's
//    case is left for its author to repair.
// 2. The offsets.  `at`, `offset` and a fault's position are one
//    counter, and a reader that counted from the start of a CHUNK gets
//    every frame after the first one wrong.  Nothing in the API suite
//    feeds two chunks.
// 3. The two framings' limits.  A declared length is checked before its
//    message arrives; a non-transparent buffer is checked when no
//    trailer has arrived.  Both are the denial of service the limit
//    exists for, and neither is in the API suite.

use std.test
use syslogframe
use syslogerror

fn octets_of(text: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(text))

fn counting_reader() -> SyslogReader
    syslogframe.reader(SyslogOctetCounting, syslogframe.default_limits())

fn line_reader() -> SyslogReader
    syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
                       syslogframe.default_limits())

@test
fn test_seven_octets_arrive_as_one_seven_octet_message() [io]
    // The name and both assertions of the release suite's case, on the
    // stream that name spells.
    test.case("`7 <13>abc` is one seven-octet message")
    match syslogframe.feed(counting_reader(), octets_of("7 <13>abc"))
        Err(_)  => test.fail("that is a well-formed frame")
        Ok(fed) =>
            match fed.frame
                None    => test.fail("nine octets arrived and the length said seven")
                Some(f) =>
                    test.assert(list.len(f.octets) == 7)
                    test.assert(f.at == 2)
                    test.assert(syslogframe.pending_len(fed.reader) == 0)
                    test.assert(syslogframe.offset(fed.reader) == 9)

    test.case("and the octets are the message, not the prefix")
    match syslogframe.feed(counting_reader(), octets_of("7 <13>abc"))
        Err(_)  => test.fail("that is a well-formed frame")
        Ok(fed) =>
            match fed.frame
                None    => test.fail("nine octets arrived and the length said seven")
                Some(f) => test.assert(f.octets == octets_of("<13>abc"))

    test.case("the message arrives in two chunks or in one, the same")
    match syslogframe.feed(counting_reader(), octets_of("7 <13"))
        Err(_)    => test.fail("a prefix is not a fault")
        Ok(first) =>
            test.assert(first.frame == None)
            match syslogframe.feed(first.reader, octets_of(">abc"))
                Err(_)     => test.fail("the rest of the message is not a fault")
                Ok(second) =>
                    match second.frame
                        None    => test.fail("the length has now arrived")
                        Some(f) =>
                            test.assert(list.len(f.octets) == 7)
                            test.assert(f.at == 2)

@test
fn test_the_offset_counter_runs_across_chunks() [io]
    // The counter `offset`, `SyslogFrame.at` and a positional fault all
    // share.  A reader that reset it per chunk would report the second
    // message of a connection at the offset of the first.
    test.case("two frames in one chunk, at 2 and at 11")
    match syslogframe.drain(counting_reader(), octets_of("7 <13>abc7 <13>def"))
        Err(_) => test.fail("both frames are complete")
        Ok(d)  =>
            test.assert(list.len(d.frames) == 2)
            test.assert(syslogframe.offset(d.reader) == 18)
            let first = list.get(d.frames, 0)
            let second = list.get(d.frames, 1)
            test.assert(first.at == 2)
            test.assert(second.at == 11)
            test.assert(second.octets == octets_of("<13>def"))

    test.case("and the second chunk continues the count")
    match syslogframe.feed(counting_reader(), octets_of("5 abcd"))
        Err(_)  => test.fail("a prefix is not a fault")
        Ok(fed) =>
            test.assert(fed.frame == None)
            match syslogframe.feed(fed.reader, octets_of("e7 <13>abc"))
                Err(_)   => test.fail("both frames are complete")
                Ok(more) =>
                    // One frame per call: the first length is the one
                    // that is complete, and the second waits for `take`.
                    test.assert(syslogframe.offset(more.reader) == 7)
                    match more.frame
                        None    => test.fail("the first frame is complete")
                        Some(f) =>
                            test.assert(f.at == 2)
                            test.assert(f.octets == octets_of("abcde"))
                    match syslogframe.take(more.reader)
                        Err(_)     => test.fail("the second frame is complete")
                        Ok(second) =>
                            test.assert(syslogframe.offset(second.reader) == 16)
                            match second.frame
                                None    => test.fail("the second frame is complete")
                                Some(f) =>
                                    test.assert(f.at == 9)
                                    test.assert(f.octets == octets_of("<13>abc"))

@test
fn test_a_fault_names_the_octet_of_the_stream_it_was_found_at() [io]
    // A chunk boundary is an artefact of how the host read its socket
    // and must not appear in a position a person reads.
    test.case("a bad length in a later chunk is at its own offset")
    // The first chunk is one whole frame, so the reader has consumed
    // seven octets by the time the unreadable length arrives.
    match syslogframe.feed(counting_reader(), octets_of("5 abcde"))
        Err(_)  => test.fail("that frame is complete")
        Ok(fed) =>
            test.assert(fed.frame != None)
            match syslogframe.feed(fed.reader, octets_of("abc def"))
                Ok(_)  => test.fail("`abc` is not a MSG-LEN")
                Err(e) =>
                    test.assert(syslogerror.code(e) == "bad_frame_length")
                    test.assert(syslogerror.is_framing_fault(e))
                    test.assert(syslogerror.offset_of(e) == 7)

    test.case("an empty MSG-LEN is refused at the octet it should start")
    match syslogframe.feed(counting_reader(), octets_of(" abcde"))
        Ok(_)  => test.fail("a space is not a digit")
        Err(e) => test.assert(syslogerror.offset_of(e) == 0)

    test.case("a non-digit inside the length is refused where it stands")
    match syslogframe.feed(counting_reader(), octets_of("5x abcde"))
        Ok(_)  => test.fail("`x` is not a digit")
        Err(e) =>
            test.assert(syslogerror.code(e) == "bad_frame_length")
            test.assert(syslogerror.offset_of(e) == 1)

    test.case("a leading zero is refused, and it is the whole prefix")
    match syslogframe.feed(counting_reader(), octets_of("0 abcde"))
        Ok(_)  => test.fail("§ 3.4.1 says non-zero")
        Err(e) => test.assert(syslogerror.code(e) == "bad_frame_length")

@test
fn test_the_limit_bounds_a_declared_length_and_a_buffer_that_never_ends() [io]
    // The limit is the reason this interface has a `SyslogLimits` at
    // all: an unbounded reader costs the sender nothing and the
    // receiver a machine.
    test.case("a declared length at the limit is a frame, one past it is a fault")
    let small = syslogframe.reader(SyslogOctetCounting, syslogframe.small_limits())
    match syslogframe.feed(small, octets_of("480 x"))
        Err(SyslogFrameTooLarge(octets, _)) => test.fail("480 is the limit, not past it")
        Err(_)                              => test.fail("wrong reason")
        Ok(fed)                             => test.assert(fed.frame == None)

    test.case("481 is past it, before one octet of the message arrives")
    let small2 = syslogframe.reader(SyslogOctetCounting, syslogframe.small_limits())
    match syslogframe.feed(small2, octets_of("481 x"))
        Ok(_)                                        => test.fail("481 is past a 480-octet limit")
        Err(SyslogFrameTooLarge(octets, max_octets)) =>
            test.assert(octets == 481)
            test.assert(max_octets == 480)
        Err(_)                                       => test.fail("wrong reason")

    test.case("under line framing the buffer is what the limit bounds")
    let small3 = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
                                    syslogframe.small_limits())
    var line = []
    var k = 0
    while k < 481
        line = list.push(line, 65 as u8)
        k += 1
    match syslogframe.feed(small3, line)
        Ok(_)                                        => test.fail("nothing ended that line")
        Err(SyslogFrameTooLarge(octets, max_octets)) =>
            test.assert(octets == 481)
            test.assert(max_octets == 480)
        Err(_)                                       => test.fail("wrong reason")

    test.case("and a line that ends inside the limit is a message")
    let small4 = syslogframe.reader(SyslogNonTransparent(SyslogTrailerLf),
                                    syslogframe.small_limits())
    match syslogframe.feed(small4, octets_of("a\n"))
        Err(_)  => test.fail("one octet and a trailer is inside any limit")
        Ok(fed) =>
            match fed.frame
                None    => test.fail("the trailer arrived")
                Some(f) => test.assert(list.len(f.octets) == 1)

@test
fn test_the_other_two_trailers_are_the_same_reader_with_more_octets() [io]
    test.case("a NUL ends a message, and is not content")
    let nul = syslogframe.reader(SyslogNonTransparent(SyslogTrailerNul),
                                 syslogframe.default_limits())
    match syslogframe.drain(nul, list.concat(octets_of("<34>a"), [0 as u8]))
        Err(_) => test.fail("the NUL ends the message")
        Ok(d)  =>
            test.assert(list.len(d.frames) == 1)
            test.assert(syslogframe.pending_len(d.reader) == 0)

    test.case("a carriage return and line feed is two octets of trailer")
    let crlf = syslogframe.reader(SyslogNonTransparent(SyslogTrailerCrLf),
                                  syslogframe.default_limits())
    match syslogframe.drain(crlf, list.concat(octets_of("<34>a"), [13 as u8, 10 as u8]))
        Err(_) => test.fail("the CRLF ends the message")
        Ok(d)  =>
            test.assert(list.len(d.frames) == 1)
            let f = list.get(d.frames, 0)
            test.assert(list.len(f.octets) == 5)
            test.assert(syslogframe.offset(d.reader) == 7)

    test.case("a carriage return with no line feed yet is a prefix")
    let crlf2 = syslogframe.reader(SyslogNonTransparent(SyslogTrailerCrLf),
                                   syslogframe.default_limits())
    match syslogframe.feed(crlf2, list.concat(octets_of("<34>a"), [13 as u8]))
        Err(_)  => test.fail("a split trailer is not a fault")
        Ok(fed) =>
            test.assert(fed.frame == None)
            match syslogframe.feed(fed.reader, [10 as u8])
                Err(_)   => test.fail("the line feed completes it")
                Ok(more) =>
                    match more.frame
                        None    => test.fail("the trailer is now whole")
                        Some(f) => test.assert(list.len(f.octets) == 5)

@test
fn test_a_frame_can_be_written_and_read_back() [io]
    // `frame` and the reader are two halves of one rule, and a message
    // containing the trailer octet is why octet counting exists.
    test.case("a line-framed message comes back as the octets it was")
    match syslogframe.frame(octets_of("<34>hello"), SyslogNonTransparent(SyslogTrailerLf))
        Err(_)     => test.fail("that message holds no line feed")
        Ok(framed) =>
            match syslogframe.feed(line_reader(), framed)
                Err(_)  => test.fail("one framed message is well-formed")
                Ok(fed) =>
                    match fed.frame
                        None    => test.fail("the trailer came with it")
                        Some(f) =>
                            test.assert(f.octets == octets_of("<34>hello"))
                            test.assert(syslogframe.pending_len(fed.reader) == 0)

    test.case("an octet-counted message with a line feed in it round-trips")
    let message = octets_of("<34>a\nb")
    match syslogframe.frame(message, SyslogOctetCounting)
        Err(_)     => test.fail("octet counting carries any octets")
        Ok(framed) =>
            match syslogframe.feed(counting_reader(), framed)
                Err(_)  => test.fail("the length it wrote is a length")
                Ok(fed) =>
                    match fed.frame
                        None    => test.fail("the whole message was written")
                        Some(f) => test.assert(f.octets == message)

    test.case("the length is the message's, not the frame's")
    match syslogframe.frame(octets_of("abcd"), SyslogOctetCounting)
        Err(_)     => test.fail("four octets frame fine")
        Ok(framed) => test.assert(framed == octets_of("4 abcd"))

    test.case("an empty message has no MSG-LEN to write")
    match syslogframe.frame([], SyslogOctetCounting)
        Ok(written) => test.fail("`0 ` is not a length § 3.4.1 allows")
        Err(e)      => test.assert(syslogerror.is_framing_fault(e))

    test.case("a trailer inside a message is refused where it sits")
    match syslogframe.frame(octets_of("<34>a\nb"), SyslogNonTransparent(SyslogTrailerLf))
        Ok(_)  => test.fail("that message contains the trailer")
        Err(e) =>
            test.assert(syslogerror.code(e) == "trailer_in_message")
            test.assert(syslogerror.offset_of(e) == 5)

@test
fn test_a_detecting_reader_settles_once_and_keeps_its_answer() [io]
    test.case("a message first settles on line framing")
    let d = syslogframe.reader(SyslogFramingDetect, syslogframe.default_limits())
    match syslogframe.feed(d, octets_of("<34>a\n<34>b"))
        Err(_)  => test.fail("nothing here is malformed")
        Ok(fed) =>
            match syslogframe.framing_of(fed.reader)
                SyslogFramingDetect => test.fail("`<` is a message")
                _                   => test.assert(true)
            match fed.frame
                None    => test.fail("the first line is complete")
                Some(f) => test.assert(f.octets == octets_of("<34>a"))
            match syslogframe.finish(fed.reader)
                Err(_)   => test.fail("the last line is a message")
                Ok(last) =>
                    match last.frame
                        None    => test.fail("the octets before the close are one")
                        Some(f) => test.assert(f.octets == octets_of("<34>b"))

    test.case("a digit first settles on octet counting")
    let d2 = syslogframe.reader(SyslogFramingDetect, syslogframe.default_limits())
    match syslogframe.feed(d2, octets_of("5 <13>"))
        Err(_)  => test.fail("that is a MSG-LEN")
        Ok(fed) =>
            match syslogframe.framing_of(fed.reader)
                SyslogOctetCounting => test.assert(true)
                _                   => test.fail("`5` is a length")
            match fed.frame
                None    => test.assert(true)
                Some(_) => test.fail("the message has not arrived")

    test.case("and an octet that begins neither leaves it undecided")
    let d3 = syslogframe.reader(SyslogFramingDetect, syslogframe.default_limits())
    match syslogframe.feed(d3, octets_of("hello"))
        Err(_)  => test.fail("undecided is not a fault yet")
        Ok(fed) =>
            match syslogframe.framing_of(fed.reader)
                SyslogFramingDetect => test.assert(true)
                _                   => test.fail("`h` begins neither framing")
            match fed.frame
                None    => test.assert(true)
                Some(_) => test.fail("nothing can be cut without a framing")
            match syslogframe.finish(fed.reader)
                Ok(_)  => test.fail("a close cannot invent a boundary")
                Err(e) => test.assert(syslogerror.is_framing_fault(e))

@test
fn test_a_close_after_a_complete_frame_is_that_frame() [io]
    test.case("the buffered frame comes out, and the close adds nothing")
    match syslogframe.feed(line_reader(), octets_of("a\nb"))
        Err(_)  => test.fail("the first line is complete")
        Ok(fed) =>
            test.assert(fed.frame != None)
            match syslogframe.finish(fed.reader)
                Err(_)   => test.fail("the second line is a message")
                Ok(last) =>
                    match last.frame
                        None    => test.fail("the octets are the last line")
                        Some(f) =>
                            test.assert(f.octets == octets_of("b"))
                            test.assert(syslogframe.offset(last.reader) == 3)

    test.case("take twice: the second takes nothing and moves nothing")
    match syslogframe.feed(line_reader(), octets_of("a\nb\n"))
        Err(_)  => test.fail("both lines are complete")
        Ok(fed) =>
            match syslogframe.take(fed.reader)
                Err(_)     => test.fail("the second line is complete")
                Ok(second) =>
                    match second.frame
                        None    => test.fail("the second line is complete")
                        Some(f) => test.assert(f.octets == octets_of("b"))
                    match syslogframe.take(second.reader)
                        Err(_)   => test.fail("an empty buffer is not a fault")
                        Ok(done) =>
                            test.assert(done.frame == None)
                            test.assert(syslogframe.offset(done.reader) == 4)
                            test.assert(syslogframe.pending_len(done.reader) == 0)

    test.case("a zero-octet line is a zero-octet message")
    match syslogframe.feed(line_reader(), [10 as u8])
        Err(_)  => test.fail("a bare trailer ends a message with nothing in it")
        Ok(fed) =>
            match fed.frame
                None    => test.fail("the trailer arrived")
                Some(f) =>
                    test.assert(list.len(f.octets) == 0)
                    test.assert(f.at == 0)
                    test.assert(syslogframe.offset(fed.reader) == 1)
